<section class="section-sm bg-blush">
  <div class="container text-center">
    <p class="eyebrow">Explore</p>
    <h1 class="section-title mb-0">Shop By Category</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="row g-4">
      <% categories.forEach(cat => { %>
        <div class="col-md-6 col-lg-4 sf-reveal">
          <a href="/categories/<%= cat.slug %>" class="category-tile d-block" style="border-radius:6px;">
            <img src="<%= cat.image %>" alt="<%= cat.name %>" style="aspect-ratio:4/3;" />
            <div class="category-tile-overlay">
              <div>
                <h5><%= cat.name %></h5>
                <span class="small text-white-50"><%= cat.description || 'Shop the collection' %></span>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>
