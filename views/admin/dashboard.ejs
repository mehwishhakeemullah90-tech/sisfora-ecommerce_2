<div id="dashboardStats">
  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-icon bg-blush text-gold mb-3"><i class="bi bi-currency-dollar"></i></div>
        <div class="stat-value" id="statRevenue">$0</div>
        <div class="stat-label">Total Revenue</div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-icon bg-blush text-gold mb-3"><i class="bi bi-box-seam"></i></div>
        <div class="stat-value" id="statOrders">0</div>
        <div class="stat-label">Total Orders</div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-icon bg-blush text-gold mb-3"><i class="bi bi-bag"></i></div>
        <div class="stat-value" id="statProducts">0</div>
        <div class="stat-label">Total Products</div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-icon bg-blush text-gold mb-3"><i class="bi bi-people"></i></div>
        <div class="stat-value" id="statCustomers">0</div>
        <div class="stat-label">Total Customers</div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-lg-4">
      <div class="admin-card p-4">
        <h6 class="mb-3">Orders by Status</h6>
        <canvas id="orderStatusChart" height="220"></canvas>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="admin-card p-4 h-100">
        <h6 class="mb-3">Low Stock Alerts</h6>
        <ul class="list-unstyled mb-0" id="lowStockList"></ul>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="admin-card p-4 h-100">
        <h6 class="mb-3">Quick Links</h6>
        <a href="/admin/products" class="btn btn-sisfora-outline btn-sm w-100 mb-2 text-start"><i class="bi bi-plus-lg me-1"></i> Add New Product</a>
        <a href="/admin/coupons" class="btn btn-sisfora-outline btn-sm w-100 mb-2 text-start"><i class="bi bi-ticket-perforated me-1"></i> Create Coupon</a>
        <a href="/admin/reports" class="btn btn-sisfora-outline btn-sm w-100 text-start"><i class="bi bi-graph-up me-1"></i> View Sales Reports</a>
      </div>
    </div>
  </div>

  <div class="admin-card">
    <div class="card-header-sf">Recent Orders</div>
    <div class="table-responsive p-3">
      <table class="table table-sf mb-0">
        <thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr></thead>
        <tbody id="recentOrdersTable"></tbody>
      </table>
    </div>
  </div>
</div>
