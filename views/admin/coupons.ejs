<div class="d-flex justify-content-between align-items-center mb-4">
  <h5 class="mb-0">Manage Coupons</h5>
  <button class="btn btn-sisfora btn-sm" id="addCouponBtn"><i class="bi bi-plus-lg me-1"></i> Add Coupon</button>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table table-sf mb-0">
      <thead><tr><th>Code</th><th>Discount</th><th>Used</th><th>Expires</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody id="couponsTableBody"></tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="couponModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Coupon</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="couponForm">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Coupon Code</label>
              <input type="text" name="code" class="form-control text-uppercase" required placeholder="SISFORA20" />
            </div>
            <div class="col-12">
              <label class="form-label">Description</label>
              <input type="text" name="description" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Discount Type</label>
              <select name="discountType" class="form-select">
                <option value="percentage">Percentage (%)</option>
                <option value="fixed">Fixed Amount ($)</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Discount Value</label>
              <input type="number" name="discountValue" class="form-control" required />
            </div>
            <div class="col-md-6">
              <label class="form-label">Min Order Amount ($)</label>
              <input type="number" name="minOrderAmount" class="form-control" value="0" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Max Discount ($, optional)</label>
              <input type="number" name="maxDiscountAmount" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Usage Limit</label>
              <input type="number" name="usageLimit" class="form-control" value="100" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Expires At</label>
              <input type="date" name="expiresAt" class="form-control" required />
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-sisfora w-100">Save Coupon</button>
        </div>
      </form>
    </div>
  </div>
</div>
