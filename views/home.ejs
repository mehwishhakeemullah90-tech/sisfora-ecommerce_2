<!-- ============================= HERO ============================= -->
<section class="hero">
  <div class="container position-relative">
    <div class="row align-items-center gy-5">
      <div class="col-lg-6">
        <p class="eyebrow mb-3 sf-reveal">Luxury Clean Beauty</p>
        <h1 class="hero-title mb-4 sf-reveal">Reveal Your<br /><em>Natural</em> Beauty</h1>
        <p class="section-subtitle mb-4 sf-reveal">Sisfora blends nature and science into rituals that let your skin's true radiance shine through — thoughtfully formulated, beautifully simple.</p>
        <div class="d-flex gap-3 sf-reveal">
          <a href="/shop" class="btn btn-sisfora">Shop Now</a>
          <a href="/best-sellers" class="btn btn-sisfora-outline">Best Sellers</a>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="hero-image-wrap sf-reveal">
          <img src="/images/products/hero-banner.svg" alt="Sisfora luxury cosmetics" class="img-fluid" />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================= CATEGORIES ============================= -->
<section class="section">
  <div class="container">
    <div class="text-center mb-5 sf-reveal">
      <p class="eyebrow">Shop By Category</p>
      <h2 class="section-title">Find Your Ritual</h2>
    </div>
    <div class="row g-3 g-md-4">
      <% categories.forEach(cat => { %>
        <div class="col-6 col-md-4 col-lg-2">
          <a href="/categories/<%= cat.slug %>" class="category-tile sf-reveal">
            <img src="<%= cat.image %>" alt="<%= cat.name %>" />
            <div class="category-tile-overlay"><h5><%= cat.name %></h5></div>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============================= FEATURED ============================= -->
<section class="section bg-ivory">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-5 sf-reveal">
      <div>
        <p class="eyebrow">Curated For You</p>
        <h2 class="section-title mb-0">Featured Favorites</h2>
      </div>
      <a href="/shop" class="btn btn-sisfora-outline d-none d-md-inline-block">View All</a>
    </div>
    <div class="row g-4">
      <% featured.forEach(p => { %>
        <div class="col-6 col-md-4 col-lg-3 sf-reveal">
          <%- include('partials/product-card-ssr', { p }) %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============================= PROMO BANNER ============================= -->
<section class="section-sm">
  <div class="container">
    <div class="promo-banner p-5 p-md-5">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <p class="eyebrow mb-2">Limited Time</p>
          <h2 class="section-title text-white">Up to 30% Off Skincare Essentials</h2>
          <p class="text-white-50 mb-4">Treat your skin to Sisfora's clean, luxury formulas — now at their best price of the season.</p>
          <a href="/offers" class="btn btn-sisfora-gold">Shop the Sale</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================= BEST SELLERS ============================= -->
<section class="section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-5 sf-reveal">
      <div>
        <p class="eyebrow">Customer Favorites</p>
        <h2 class="section-title mb-0">Best Sellers</h2>
      </div>
      <a href="/best-sellers" class="btn btn-sisfora-outline d-none d-md-inline-block">View All</a>
    </div>
    <div class="row g-4">
      <% bestSellers.forEach(p => { %>
        <div class="col-6 col-md-4 col-lg-3 sf-reveal">
          <%- include('partials/product-card-ssr', { p }) %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============================= NEW ARRIVALS ============================= -->
<section class="section bg-blush">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-5 sf-reveal">
      <div>
        <p class="eyebrow">Just Landed</p>
        <h2 class="section-title mb-0">New Arrivals</h2>
      </div>
      <a href="/new-arrivals" class="btn btn-sisfora-outline d-none d-md-inline-block">View All</a>
    </div>
    <div class="row g-4">
      <% newArrivals.forEach(p => { %>
        <div class="col-6 col-md-4 col-lg-3 sf-reveal">
          <%- include('partials/product-card-ssr', { p }) %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

