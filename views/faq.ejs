<section class="section-sm bg-blush">
  <div class="container text-center">
    <p class="eyebrow">Need Help?</p>
    <h1 class="section-title mb-0">Frequently Asked Questions</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <div class="accordion" id="faqAccordion">

          <div class="accordion-item mb-2 border-sf">
            <h2 class="accordion-header">
              <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">How long does shipping take?</button>
            </h2>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted">Orders are typically processed within 1-2 business days and delivered within 3-7 business days domestically. Shipping is free on all orders over $50.</div>
            </div>
          </div>

          <div class="accordion-item mb-2 border-sf">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">What is your return policy?</button>
            </h2>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted">We offer a 30-day return policy on unused, unopened products. If you're not fully satisfied, contact our support team to start a return.</div>
            </div>
          </div>

          <div class="accordion-item mb-2 border-sf">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">Are Sisfora products cruelty-free?</button>
            </h2>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted">Yes! Every Sisfora product is 100% cruelty-free — we never test on animals, at any stage of production.</div>
            </div>
          </div>

          <div class="accordion-item mb-2 border-sf">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">What payment methods do you accept?</button>
            </h2>
            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted">We accept all major credit/debit cards (via Stripe) as well as Cash on Delivery in select regions.</div>
            </div>
          </div>

          <div class="accordion-item mb-2 border-sf">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">How do I track my order?</button>
            </h2>
            <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted">Once logged in, visit "My Account" &rarr; "Order History" to view the live status of every order you've placed with us.</div>
            </div>
          </div>

          <div class="accordion-item mb-2 border-sf">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq6">Do you ship internationally?</button>
            </h2>
            <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted">We currently ship across Pakistan and select international destinations. More regions are added regularly — contact us if you don't see yours.</div>
            </div>
          </div>

        </div>
        <p class="text-center text-muted mt-5">Still have questions? <a href="/contact" class="text-gold">Contact our team</a>.</p>
      </div>
    </div>
  </div>
</section>
