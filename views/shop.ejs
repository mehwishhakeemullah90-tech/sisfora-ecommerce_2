<section class="section-sm bg-blush">
  <div class="container">
    <p class="breadcrumb-sf mb-2"><a href="/">Home</a> / <span class="text-dark"><%= typeof categoryName !== 'undefined' ? categoryName : 'Shop' %></span></p>
    <h1 class="section-title mb-0"><%= typeof categoryName !== 'undefined' ? categoryName : 'Shop All Products' %></h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="row g-4">
      <!-- Filters sidebar -->
      <div class="col-lg-3">
        <form id="shopFilterForm" class="filter-sidebar">
          <div class="mb-4">
            <input type="text" id="shopSearchInput" class="form-control" placeholder="Search products..." value="<%= typeof locals.keyword !== 'undefined' ? locals.keyword : '' %>" />
          </div>

          <h6 class="mb-3">Category</h6>
          <div class="mb-4">
            <% categories.forEach(cat => { %>
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="category" value="<%= cat.slug %>" id="cat-<%= cat.slug %>">
                <label class="form-check-label" for="cat-<%= cat.slug %>"><%= cat.name %></label>
              </div>
            <% }) %>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="category" value="" id="cat-all" checked>
              <label class="form-check-label" for="cat-all">All Categories</label>
            </div>
          </div>

          <h6 class="mb-3">Brand</h6>
          <div class="mb-4">
            <% brands.forEach(brand => { %>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="brand" value="<%= brand %>" id="brand-<%= brand.replace(/\s+/g,'-') %>">
                <label class="form-check-label" for="brand-<%= brand.replace(/\s+/g,'-') %>"><%= brand %></label>
              </div>
            <% }) %>
          </div>

          <h6 class="mb-3">Price Range</h6>
          <div class="row g-2 mb-4">
            <div class="col-6"><input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Min"></div>
            <div class="col-6"><input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Max"></div>
          </div>
        </form>
      </div>

      <!-- Product grid -->
      <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
          <span id="shopResultsCount" class="text-muted small">Loading...</span>
          <select id="shopSort" class="form-select form-select-sm" style="width:200px;">
            <option value="">Sort: Featured</option>
            <option value="price_asc">Price: Low to High</option>
            <option value="price_desc">Price: High to Low</option>
            <option value="rating">Top Rated</option>
            <option value="bestselling">Best Selling</option>
          </select>
        </div>
        <div class="row g-4" id="shopProductGrid" data-preset-category="<%= typeof presetCategory !== 'undefined' ? presetCategory : '' %>"></div>
        <nav class="mt-5">
          <ul class="pagination justify-content-center" id="shopPagination"></ul>
        </nav>
      </div>
    </div>
  </div>
</section>

<script src="/js/product.js"></script>
