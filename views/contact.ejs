<section class="section-sm bg-blush">
  <div class="container text-center">
    <p class="eyebrow">We'd Love to Hear From You</p>
    <h1 class="section-title mb-0">Contact Us</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-5">
        <h4 class="mb-4">Get in Touch</h4>
        <p class="section-subtitle mb-4">Have a question about an order, a product recommendation, or just want to say hello? Our team is here to help.</p>
        <div class="d-flex gap-3 mb-3">
          <i class="bi bi-geo-alt text-gold fs-5"></i>
          <div><strong>Studio</strong><div class="text-muted small">123 Beauty Avenue, Lahore, Pakistan</div></div>
        </div>
        <div class="d-flex gap-3 mb-3">
          <i class="bi bi-envelope text-gold fs-5"></i>
          <div><strong>Email</strong><div class="text-muted small">hello@sisfora.com</div></div>
        </div>
        <div class="d-flex gap-3 mb-4">
          <i class="bi bi-telephone text-gold fs-5"></i>
          <div><strong>Phone</strong><div class="text-muted small">+92 300 1234567</div></div>
        </div>
        <div class="d-flex gap-2">
          <a href="#" class="btn-sm-icon"><i class="bi bi-instagram"></i></a>
          <a href="#" class="btn-sm-icon"><i class="bi bi-facebook"></i></a>
          <a href="#" class="btn-sm-icon"><i class="bi bi-tiktok"></i></a>
        </div>
      </div>
      <div class="col-lg-7">
        <div class="admin-card p-4 p-md-5">
          <div id="contactSuccess" class="alert alert-success d-none" role="alert">
            <i class="bi bi-check-circle me-2"></i>Thank you! We've received your message and will respond within 24 hours.
          </div>
          <div id="contactError" class="alert alert-danger d-none" role="alert"></div>
          <form id="contactForm" novalidate>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input type="text" name="fullName" class="form-control" placeholder="Your full name" required />
              </div>
              <div class="col-md-6">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="your@email.com" required />
              </div>
              <div class="col-12">
                <label class="form-label">Subject</label>
                <input type="text" name="subject" class="form-control" placeholder="What is this about?" required />
              </div>
              <div class="col-12">
                <label class="form-label">Message</label>
                <textarea name="message" class="form-control" rows="5" placeholder="Write your message here..." required></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-sisfora w-100" id="contactSubmitBtn">
                  <span id="contactBtnText">SEND MESSAGE</span>
                  <span id="contactBtnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('contactForm').addEventListener('submit', async function (e) {
    e.preventDefault();

    const form = this;
    const successBox = document.getElementById('contactSuccess');
    const errorBox = document.getElementById('contactError');
    const btnText = document.getElementById('contactBtnText');
    const spinner = document.getElementById('contactBtnSpinner');
    const submitBtn = document.getElementById('contactSubmitBtn');

    // Hide previous messages
    successBox.classList.add('d-none');
    errorBox.classList.add('d-none');

    // Basic validation
    const fullName = form.fullName.value.trim();
    const email    = form.email.value.trim();
    const subject  = form.subject.value.trim();
    const message  = form.message.value.trim();

    if (!fullName || !email || !subject || !message) {
      errorBox.textContent = 'Please fill in all fields before sending.';
      errorBox.classList.remove('d-none');
      return;
    }

    // Show loading state
    btnText.textContent = 'Sending...';
    spinner.classList.remove('d-none');
    submitBtn.disabled = true;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fullName, email, subject, message }),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        successBox.classList.remove('d-none');
        form.reset();
      } else {
        errorBox.textContent = data.message || 'Something went wrong. Please try again.';
        errorBox.classList.remove('d-none');
      }
    } catch (err) {
      errorBox.textContent = 'Network error. Please check your connection and try again.';
      errorBox.classList.remove('d-none');
    } finally {
      btnText.textContent = 'SEND MESSAGE';
      spinner.classList.add('d-none');
      submitBtn.disabled = false;
    }
  });
</script>
