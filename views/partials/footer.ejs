<!-- Newsletter -->
<section class="newsletter-band py-5">
  <div class="container text-center">
    <p class="eyebrow mb-2">Stay In The Glow</p>
    <h3 class="section-title mb-3">Join the Sisfora Circle</h3>
    <p class="section-subtitle mx-auto mb-4">Be the first to know about new arrivals, exclusive offers, and beauty rituals — straight to your inbox.</p>
    <form class="d-flex justify-content-center flex-wrap gap-2" id="newsletterForm" style="max-width: 460px; margin: 0 auto;">
      <input type="email" required class="form-control" placeholder="Your email address" style="max-width: 300px;" />
      <button type="submit" class="btn btn-sisfora">Subscribe</button>
    </form>
  </div>
</section>

<footer class="sf-footer pt-5 pb-3">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <a href="/" class="navbar-brand sf-logo text-white mb-2 d-inline-block">Sis<span>fora</span></a>
        <p class="small mb-3">Reveal Your Natural Beauty. Sisfora crafts clean, luxurious cosmetics designed to celebrate every skin story.</p>
        <div class="d-flex gap-2">
          <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
          <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
          <a href="#" class="social-icon"><i class="bi bi-tiktok"></i></a>
          <a href="#" class="social-icon"><i class="bi bi-pinterest"></i></a>
        </div>
      </div>
      <div class="col-lg-2 col-md-6 col-6">
        <h6>Shop</h6>
        <ul class="list-unstyled small">
          <li class="mb-2"><a href="/shop">All Products</a></li>
          <li class="mb-2"><a href="/best-sellers">Best Sellers</a></li>
          <li class="mb-2"><a href="/new-arrivals">New Arrivals</a></li>
          <li class="mb-2"><a href="/offers">Offers</a></li>
          <li class="mb-2"><a href="/categories">Categories</a></li>
        </ul>
      </div>
      <div class="col-lg-2 col-md-6 col-6">
        <h6>Company</h6>
        <ul class="list-unstyled small">
          <li class="mb-2"><a href="/about">About Us</a></li>
          <li class="mb-2"><a href="/blog">Journal</a></li>
          <li class="mb-2"><a href="/contact">Contact</a></li>
          <li class="mb-2"><a href="/faq">FAQ</a></li>
        </ul>
      </div>
      <div class="col-lg-2 col-md-6 col-6">
        <h6>Legal</h6>
        <ul class="list-unstyled small">
          <li class="mb-2"><a href="/privacy-policy">Privacy Policy</a></li>
          <li class="mb-2"><a href="/terms">Terms &amp; Conditions</a></li>
        </ul>
      </div>
      <div class="col-lg-2 col-md-6">
        <h6>Account</h6>
        <ul class="list-unstyled small">
          <li class="mb-2"><a href="/profile">My Account</a></li>
          <li class="mb-2"><a href="/profile?tab=orders">Order History</a></li>
          <li class="mb-2"><a href="/cart">Cart</a></li>
        </ul>
      </div>
    </div>
    <div class="sf-footer-bottom mt-4 pt-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
      <span>&copy; <%= currentYear %> Sisfora. All rights reserved.</span>
      <span>Crafted with <i class="bi bi-heart-fill text-pink"></i> for natural beauty</span>
    </div>
  </div>
</footer>
