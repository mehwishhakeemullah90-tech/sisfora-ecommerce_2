<section class="section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-5">
        <div class="auth-card p-5">
          <p class="eyebrow mb-2">Sisfora</p>
          <h3 class="mb-2">Forgot Password?</h3>
          <p class="text-muted small mb-4">Enter your email address and we'll send you a link to reset your password.</p>
          <form id="forgotPasswordForm">
            <div class="mb-4">
              <label class="form-label">Email Address</label>
              <input type="email" name="email" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-sisfora w-100 mb-3">Send Reset Link</button>
            <p class="text-center small text-muted mb-0"><a href="/login" class="text-gold">Back to Login</a></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
