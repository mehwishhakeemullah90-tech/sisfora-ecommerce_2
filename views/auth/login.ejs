<section class="section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="auth-card overflow-hidden">
          <div class="row g-0">
            <div class="col-md-5 auth-side d-none d-md-flex align-items-center justify-content-center p-5">
              <div class="text-center">
                <h2 class="font-display mb-3">Welcome Back</h2>
                <p class="text-muted">Sign in to track orders, manage your wishlist, and enjoy a faster checkout.</p>
              </div>
            </div>
            <div class="col-md-7 p-5">
              <p class="eyebrow mb-2">Sisfora</p>
              <h3 class="mb-4">Login to Your Account</h3>
              <form id="loginForm" data-redirect="<%= redirect %>">
                <div class="mb-3">
                  <label class="form-label">Email Address</label>
                  <input type="email" name="email" class="form-control" required />
                </div>
                <div class="mb-2">
                  <label class="form-label">Password</label>
                  <input type="password" name="password" class="form-control" required />
                </div>
                <div class="d-flex justify-content-end mb-4">
                  <a href="/forgot-password" class="small text-gold">Forgot password?</a>
                </div>
                <button type="submit" class="btn btn-sisfora w-100 mb-3">Login</button>
                <p class="text-center small text-muted mb-0">Don't have an account? <a href="/register" class="text-gold">Create one</a></p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
