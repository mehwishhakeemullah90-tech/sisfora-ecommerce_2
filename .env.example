# =========================================
# Sisfora - Environment Configuration
# Copy this file to .env and fill in real values
# =========================================

# Server
NODE_ENV=development
PORT=7000
BASE_URL=http://localhost:7000

# MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sisfora?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sisfora?retryWrites=true&w=majority&appName=Cluster0

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_DAYS=30

# Admin bootstrap
ADMIN_NAME=Sisfora Admin
ADMIN_EMAIL=admin@sisfora.com
ADMIN_PASSWORD=change_this_admin_password

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@sisfora.com

# Currency / Store
CURRENCY=USD
STORE_NAME=Sisfora
